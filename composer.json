{
  "name": "luciolemos/my-app",
  "description": "My PHP MVC Application",
  "version": "1.0.0",
  "require": {
    "php": "^8.4",
    "slim/slim": "^4.0",
    "twig/twig": "^3.0",
    "vlucas/phpdotenv": "^5.6",
    "erusev/parsedown": "^1.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "platform": {
      "php": "8.4"
    }
  }
}
