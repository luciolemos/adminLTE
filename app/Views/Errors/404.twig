{% extends 'base.twig' %}

{% block title %}Página não encontrada{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-center min-vh-100">
  <div class="text-center">
    <h1 class="display-1 text-danger">404</h1>
    <h2 class="mb-3">Página não encontrada</h2>
    <p class="text-muted">A página que você procura não existe ou foi removida.</p>
    <a href="/" class="btn btn-primary mt-4"><i class="fas fa-home"></i> Voltar ao início</a>
  </div>
</div>
{% endblock %}

