{# Admin/Tools/dashboard.twig #}
{% extends "layout_admin.twig" %}
{% block title %}Dashboard de Ferramentas{% endblock %}

{% block styles %}
  {{ parent() }}
  <style>
    :root {
      --grad-info: linear-gradient(135deg, #2193b0 0%, #6dd5ed 100%);
      --grad-success: linear-gradient(135deg, #56ab2f 0%, #a8e063 100%);
      --grad-warning: linear-gradient(135deg, #f7971e 0%, #ffd200 100%);
      --grad-danger: linear-gradient(135deg, #ee0979 0%, #ff6a00 100%);
      --grad-secondary: linear-gradient(135deg, #485563 0%, #29323c 100%);
      --grad-primary: linear-gradient(135deg, #396afc 0%, #2948ff 100%);
      --grad-light: linear-gradient(135deg, #f8ffae 0%, #43c6ac 100%);
    }

    .dashboard-card {
      border: none;
      border-radius: 1.4rem;
      font-family: 'Inter', Arial, sans-serif;
      transition: transform .17s cubic-bezier(.4,2,.6,1), box-shadow .18s, filter .18s;
      box-shadow: 0 2px 12px rgba(60, 60, 120, 0.10);
      position: relative;
      overflow: hidden;
      min-height: 154px;
      cursor: pointer;
      background: var(--grad-info);
      color: #fff;
      filter: brightness(.98);
    }
    .dashboard-card.bg-gradient-info      { background: var(--grad-info); }
    .dashboard-card.bg-gradient-success   { background: var(--grad-success); }
    .dashboard-card.bg-gradient-warning   { background: var(--grad-warning); color:#423d00; }
    .dashboard-card.bg-gradient-danger    { background: var(--grad-danger); }
    .dashboard-card.bg-gradient-secondary { background: var(--grad-secondary); }
    .dashboard-card.bg-gradient-primary   { background: var(--grad-primary); }
    .dashboard-card.bg-gradient-light     { background: var(--grad-light); color:#222; }

    .dashboard-card .icon-bg {
      position: absolute; right: 1.2rem; top: 1.1rem;
      font-size: 3.7rem; opacity: .15; line-height: 1;
      pointer-events: none; filter: blur(1px);
    }
    .dashboard-card .display-4 {
      font-size: 2.3rem; font-weight: 800; margin-bottom: .1rem;
      color: #fff; text-shadow: 0 2px 6px rgba(10,20,60,.09); letter-spacing: -1px;
    }
    .dashboard-card.bg-gradient-light .display-4 { color:#333; }
    .dashboard-card .card-title {
      margin-bottom: .45rem; font-size: 1.06rem; font-weight: 500; letter-spacing: .5px;
      text-shadow: 0 1px 2px rgba(0,0,0,.09); color: #fff; opacity: .96;
    }
    .dashboard-card.bg-gradient-warning .card-title { color:#423d00; }
    .dashboard-card.bg-gradient-light   .card-title { color:#2c3e50; }
    .dashboard-card .btn-see {
      margin-top: .15rem; font-size: .99rem; color: #eaf6ff;
      background: rgba(0,0,0,.10); border: none; border-radius: 1rem;
      transition: background .11s, color .09s; padding: 2px 17px; font-weight: 500;
      box-shadow: none;
    }
    .dashboard-card .btn-see:hover { background: rgba(255,255,255,.16); color: #fff; filter: brightness(1.1); }
    .dashboard-card:hover {
      transform: translateY(-7px) scale(1.028);
      box-shadow: 0 10px 40px rgba(44,128,224,.14), 0 1.5px 8px rgba(30,40,60,.12);
      z-index: 3; filter: brightness(1.03) saturate(1.09); animation: pop-card .22s;
    }
    @keyframes pop-card { 0%{transform:scale(1)}70%{transform:scale(1.035)}100%{transform:scale(1.028)} }
    @media (max-width: 575px) {
      .dashboard-card { min-height: 110px; }
      .dashboard-card .icon-bg { font-size: 1.7rem; top: .7rem; right: .7rem; }
      .dashboard-card .display-4 { font-size: 1.3rem; }
    }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;700;900&display=swap" rel="stylesheet">
{% endblock %}

{% block content %}

  {# --------- HEADER (Título e Breadcrumb) --------- #}
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1><i class="fas fa-tools"></i> {{ title }}</h1>
        </div>
        <div class="col-sm-6">
          {% include 'Partials/_breadcrumb.twig' %}
        </div>
      </div>
    </div>
  </section>

  <div class="row">

    {# ==== Card Total Ferramentas ==== #}
    <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
      <a href="/admin/tools" class="text-decoration-none">
        <div class="card dashboard-card bg-gradient-info text-center h-100">
          <span class="icon-bg"><i class="fas fa-tools"></i></span>
          <div class="card-body position-relative">
            <div class="card-title">Total Ferramentas</div>
            <div class="display-4">{{ total_tools|default(0) }}</div>
            <div><span class="btn btn-see">Ver todas</span></div>
          </div>
        </div>
      </a>
    </div>

    {# ==== Cards por Tipo (Nova, Usada, Restaurada, Danificada) ==== #}
    {% set type_colors = {'Nova':'success','Usada':'primary','Restaurada':'warning','Danificada':'danger'} %}
    {% set type_icons  = {'Nova':'fa-sparkles fa-star','Usada':'fa-recycle','Restaurada':'fa-tools','Danificada':'fa-wrench'} %}

    {% set type_options = type_options|default(['Nova','Usada','Restaurada','Danificada']) %}
    {% for t in type_options %}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
        <a href="/admin/tools?type_tool={{ t }}" class="text-decoration-none">
          <div class="card dashboard-card bg-gradient-{{ type_colors[t]|default('secondary') }} text-center h-100">
            <span class="icon-bg"><i class="fas {{ type_icons[t]|default('fa-tag') }}"></i></span>
            <div class="card-body position-relative">
              <div class="card-title">{{ t }}</div>
              <div class="display-4">{{ type_counts[t]|default(0) }}</div>
              <div><span class="btn btn-see">Ver {{ t|lower }}</span></div>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}

    {# ==== Cards por Categoria ==== #}
    {# Espera: cat_options (array de nomes) e cat_counts (mapa nome->qtd) #}
    {% set cat_colors = {
      'Ferramentas elétricas':'primary',
      'Ferramentas hidráulicas':'info',
      'Ferramentas de carpintaria e marcenaria':'warning',
      'Ferramentas de corte':'danger',
      'Ferramentas de medição':'success',
      'Outras':'secondary'
    } %}
    {% set cat_icons = {
      'Ferramentas elétricas':'fa-bolt',
      'Ferramentas hidráulicas':'fa-water',
      'Ferramentas de carpintaria e marcenaria':'fa-hammer',
      'Ferramentas de corte':'fa-cut',
      'Ferramentas de medição':'fa-ruler-combined',
      'Outras':'fa-toolbox'
    } %}

    {% set cat_options = cat_options|default(['Ferramentas elétricas','Ferramentas hidráulicas','Ferramentas de carpintaria e marcenaria','Ferramentas de corte','Ferramentas de medição','Outras']) %}
    {% for c in cat_options %}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
        <a href="/admin/tools?cat_tool={{ c|url_encode }}" class="text-decoration-none">
          <div class="card dashboard-card
            {% if cat_colors[c]|default('light') == 'light' %} text-dark {% else %} text-white {% endif %}
            bg-gradient-{{ cat_colors[c]|default('light') }} text-center h-100">
            <span class="icon-bg"><i class="fas {{ cat_icons[c]|default('fa-tags') }}"></i></span>
            <div class="card-body position-relative">
              <div class="card-title">{{ c }}</div>
              <div class="display-4">{{ cat_counts[c]|default(0) }}</div>
              <div><span class="btn btn-see">Ver {{ c|lower }}</span></div>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}

    {# ==== Exemplos de KPIs extras (opcional) ==== #}
    {# últimos 30 dias, com manutenção, sem imagem, etc. Alimente via controller #}
    {% if recent_30_days_count is defined %}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
        <a href="/admin/tools?created=last30" class="text-decoration-none">
          <div class="card dashboard-card bg-gradient-primary text-center h-100">
            <span class="icon-bg"><i class="fas fa-calendar-plus"></i></span>
            <div class="card-body position-relative">
              <div class="card-title">Adquiridas (30 dias)</div>
              <div class="display-4">{{ recent_30_days_count|default(0) }}</div>
              <div><span class="btn btn-see">Ver novas</span></div>
            </div>
          </div>
        </a>
      </div>
    {% endif %}

    {% if damaged_count is defined %}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
        <a href="/admin/tools?type_tool=Danificada" class="text-decoration-none">
          <div class="card dashboard-card bg-gradient-danger text-center h-100">
            <span class="icon-bg"><i class="fas fa-exclamation-triangle"></i></span>
            <div class="card-body position-relative">
              <div class="card-title">Danificadas</div>
              <div class="display-4">{{ damaged_count|default(0) }}</div>
              <div><span class="btn btn-see">Ver danificadas</span></div>
            </div>
          </div>
        </a>
      </div>
    {% endif %}

  </div>
{% endblock %}
