{# Partials/_chart.twig #}
<div class="col-12 col-lg-6 mb-4">
  <div class="card shadow-sm h-100">
    <div class="card-header d-flex align-items-center">
      <h3 class="card-title mb-0">
        <i class="{{ icon|default('fas fa-chart-pie') }} mr-1"></i> {{ title|default('Gráfico') }}
      </h3>
      {% if url is defined %}
        <div class="card-tools">
          <a href="{{ url }}" class="btn btn-tool" title="Abrir dashboard">
            <i class="fas fa-external-link-alt"></i>
          </a>
        </div>
      {% endif %}
    </div>
    <div class="card-body">
      <canvas id="{{ id }}" height="140" class="w-100"></canvas>
    </div>
  </div>
</div>
