{# 
  O layout base que todo painel de administração herda. 
  Ele deve conter a estrutura HTML principal (head, body, navbar, sidebar, footer).
#}
{% extends "layout_admin.twig" %}

{# 
  Define o título da aba do navegador. 
  Esse conteúdo vai preencher o bloco "title" definido no layout base.
#}
{% block title %}Visão geral{% endblock %}

{# 
  Bloco de estilos (CSS).
  Aqui adicionamos fontes, variáveis CSS e estilos do dashboard.
#}
{% block styles %}
  {{ parent() }}
  {% include 'Admin/Partials/_dashboard_styles.twig' %}
{% endblock %}

{# 
  Bloco de conteúdo principal do dashboard.
#}
{% block content %}
  {# Cabeçalho do dashboard: título e ícone #}
  {% include 'Admin/Partials/_dashboard_header.twig' with {
    title: title,
    icon: 'fas fa-tachometer-alt'
  } %}

  <section class="content">
    <div class="container-fluid" id="dashboardExportArea">

      {# ---- KPIs principais (cards com números resumidos) ---- #}
      <div class="row">
        {# Total de usuários #}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/users',
            icon: 'fas fa-users',
            gradient: 'primary',
            title: 'Usuários',
            value: total_users,
            btn_text: 'Ver todos'
          } %}
        </div>

        {# Total de ferramentas #}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/tools',
            icon: 'fas fa-tools',
            gradient: 'info',
            title: 'Ferramentas',
            value: total_tools,
            btn_text: 'Ver todas'
          } %}
        </div>

        {# Total de posts #}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/posts',
            icon: 'fas fa-comments',
            gradient: 'secondary',
            title: 'Posts',
            value: total_posts,
            btn_text: 'Ver todos'
          } %}
        </div>

        {# Total de ferramentas danificadas #}
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/tools?type_tool=Danificada',
            icon: 'fas fa-exclamation-triangle',
            gradient: 'danger',
            title: 'Ferramentas danificadas',
            value: tools_damaged,
            btn_text: 'Ver danificadas'
          } %}
        </div>
      </div>

      {# ---- Barra de filtros rápidos ---- #}
      {% include 'Admin/Partials/_quick_filters.twig' with {
        filters: [
          { url: '/admin/users?status=Ativo', color: 'success', icon: 'fas fa-user-check', title: 'Usuários ativos', label: 'Usuários ativos' },
          { url: '/admin/users?status=Pendente', color: 'warning', icon: 'fas fa-user-clock', title: 'Usuários pendentes', label: 'Pendentes' },
          { url: '/admin/tools?type_tool=Usada', color: 'info', icon: 'fas fa-recycle', title: 'Ferramentas usadas', label: 'Ferramentas usadas' },
          { url: '/admin/tools?recent_days=30', color: 'primary', icon: 'fas fa-bolt', title: 'Ferramentas adquiridas 30 dias', label: 'Aquis. 30 dias' },
          { url: '/admin/tools?cat_tool=Ferramentas%20de%20marcenaria', color: 'secondary', icon: 'fas fa-hammer', title: 'Categoria marcenaria', label: 'Marcenaria' }
        ]
      } %}

      {# ---- Destaques por período (últimos 30 dias) ---- #}
      <div class="row">
        {# Novos usuários #}
        <div class="col-12 col-md-4 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/users?recent_days=30',
            icon: 'fas fa-user-plus',
            gradient: 'success',
            title: 'Usuários (últimos 30 dias)',
            value: users_last30,
            btn_text: 'Filtrar 30 dias'
          } %}
        </div>

        {# Novas ferramentas adquiridas #}
        <div class="col-12 col-md-4 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/tools?recent_days=30',
            icon: 'fas fa-bolt',
            gradient: 'warning',
            title: 'Ferramentas adquiridas (30 dias)',
            value: tools_last30,
            btn_text: 'Filtrar 30 dias'
          } %}
        </div>

        {# Novos posts realizados #}
        <div class="col-12 col-md-4 mb-4">
          {% include 'Admin/Partials/_dashboard_card.twig' with {
            url: '/admin/posts?recent_days=30',
            icon: 'fas fa-bolt',
            gradient: 'primary',
            title: 'Posts realizados (30 dias)',
            value: posts_last30,
            btn_text: 'Filtrar 30 dias'
          } %}
        </div>
      </div>

      {# ---- Gráficos com Chart.js ---- #}
      <div class="row">
        {# Gráfico de usuários por status #}
        {% include 'Admin/Partials/_chart.twig' with {
          id: 'chartUsersStatus',
          icon: 'fas fa-chart-pie',
          title: 'Usuários por status',
          url: '/admin/users/dashboard'
        } %}

        {# Gráfico de ferramentas por tipo #}
        {% include 'Admin/Partials/_chart.twig' with {
          id: 'chartToolsType',
          icon: 'fas fa-chart-doughnut',
          title: 'Ferramentas por tipo',
          url: '/admin/tools/dashboard'
        } %}
      </div>

      {# ---- Widget de saúde do sistema ---- #}
      <div class="row">
        <div class="col-12 mb-4">
          {% include 'Admin/Partials/_system_health.twig' with {
            storage_usage_pct: storage_usage_pct|default(42),
            storage_used_h: storage_used_h|default('420 MB'),
            storage_total_h: storage_total_h|default('1 GB'),
            jobs_pending: jobs_pending|default(0),
            emails_today: emails_today|default(0),
            backup_ok: backup_ok|default(true),
            backup_human: backup_human|default('há 12h')
          } %}
        </div>
      </div>

      {# ---- Ações rápidas (atalhos do painel) ---- #}
      <div class="row">
        <div class="col-12">
          <div class="card shadow-sm">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-bolt mr-1"></i> Ações Rápidas
              </h3>
            </div>
            <div class="card-body d-flex flex-column flex-sm-row flex-wrap">
  <a href="/admin/users/create" class="btn btn-primary mb-2 mr-sm-2 flex-fill">
    <i class="fas fa-user-plus mr-1"></i> Novo usuário
  </a>
  <a href="/admin/tools/create" class="btn btn-success mb-2 mr-sm-2 flex-fill">
    <i class="fas fa-plus mr-1"></i> Nova ferramenta
  </a>
  <a href="/admin/posts/create" class="btn btn-danger mb-2 mr-sm-2 flex-fill">
    <i class="fas fa-plus mr-1"></i> Nova postagem
  </a>
  <a href="/admin/tools?type_tool=Usada" class="btn btn-info mb-2 mr-sm-2 flex-fill">
    <i class="fas fa-filter mr-1"></i> Ferramentas usadas
  </a>
  <a href="/admin/tools?cat_tool=Ferramentas%20de%20marcenaria" class="btn btn-secondary mb-2 flex-fill">
    <i class="fas fa-filter mr-1"></i> Categoria: marcenaria
  </a>
</div>

          </div>
        </div>
      </div>

      {# ---- Atividade recente (últimos registros) ---- #}
      <div class="row">
        {# Tabela de usuários recentes #}
{% include 'Admin/Partials/_recent_table.twig' with {
  title: 'Usuários recentes',
  icon: 'fas fa-history',
  url: '/admin/users',
  columns: [
    { label: 'Nome', field: 'nome', link: '/admin/users/show' },
    { label: 'E-mail', field: 'email' },
    { label: 'Cadastro', field: 'data_cadastro', align: 'right' }
  ],
  rows: recent_users
} %}


        {# Tabela de ferramentas recentes #}
        {% include 'Admin/Partials/_recent_table.twig' with {
  title: 'Ferramentas recentes',
  icon: 'fas fa-history',
  url: '/admin/tools',
  columns: [
    { label: 'Descrição', field: 'desc_tool', link: '/admin/tools/show' },
    { label: 'Categoria', field: 'cat_tool' },
    { label: 'Aquisição', field: 'data_aquisicao', align: 'right' }
  ],
  rows: recent_tools
} %}

      </div>

    </div>
  </section>
{% endblock %}

{# 
  Scripts específicos do dashboard.
  Inclui o Chart.js e a configuração dinâmica dos gráficos.
#}
{% block scripts %}
  {{ parent() }}
  {% include 'Admin/Partials/_dashboard_scripts.twig' with {
    charts: {
      chartUsersStatus: { type: 'doughnut', data: users_by_status },
      chartToolsType:   { type: 'pie', data: tools_by_type }
    }
  } %}
{% endblock %}
