{% extends "layout_admin.twig" %}

{% block title %}Posts{% endblock %}

{% block styles %}
  {{ parent() }}
  <style>
    .dataTables_paginate .pagination li:not(.previous):not(.next):nth-child(n+7) {
      display: none;
    }
  </style>
{% endblock %}

{% block content %}

  {# --------- HEADER (Título e Breadcrumb) --------- #}
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1><i class="fas fa-comments"></i> {{ title }}</h1>
        </div>
        <div class="col-sm-6">
          {% include 'Partials/_breadcrumb.twig' %}
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-12">

          <div class="card card-outline shadow">
            <div class="card-header">
              <div class="card-tools">
                <a href="/admin/posts/dashboard" class="btn btn-tool" title="Dashboard de posts">
                  <i class="fas fa-tachometer-alt"></i>
                </a>
                <a href="/admin/posts/create" class="btn btn-tool" title="Novo post">
                  <i class="fas fa-plus"></i>
                </a>
                <button type="button" class="btn btn-tool" data-card-widget="maximize" title="Maximizar">
                  <i class="fas fa-expand"></i>
                </button>
                <div class="btn-group">
                  <button type="button" class="btn btn-tool dropdown-toggle" data-toggle="dropdown">
                    <i class="fas fa-ellipsis-v"></i>
                  </button>
                  <div class="dropdown-menu dropdown-menu-right" role="menu">
                    <a href="/admin/posts/create" class="dropdown-item">
                      <i class="fas fa-plus"></i> Novo post
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item">
                      <i class="fas fa-cog"></i> Configurações
                    </a>
                  </div>
                </div>
                <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                  <i class="fas fa-minus"></i>
                </button>
              </div>
            </div>

            <div class="card-body">
              <div class="table-responsive">
                <table
                  id="postsTable"
                  class="table table-bordered table-hover table-striped align-middle mb-0"
                  style="width:100%"
                >
                  <thead class="thead-light">
                    <tr>
                      <th class="text-center">ID</th>
                      <th class="text-center">TÍTULO</th>
                      <th class="text-center">CATEGORIA</th>
                      <th class="text-center">STATUS</th>
                      <th class="text-center">AUTOR</th>
                      <th class="text-center">CRIADO EM</th>
                      <th class="text-center" style="width:140px;">AÇÕES</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for post in posts %}
                      <tr>
                        <td class="text-center">{{ post.id }}</td>
                        <td>
                          <a href="/blog/{{ post.slug }}" target="_blank" title="Visualizar post no Blog" class="font-weight-bold">
                            {{ post.titulo }}
                          </a>
                        </td>
                        <td class="text-center">{{ post.categoria }}</td>
                        <td class="text-center">
                          {% if post.status == 'publicado' %}
                            <span class="badge badge-success">Publicado</span>
                          {% else %}
                            <span class="badge badge-secondary">Rascunho</span>
                          {% endif %}
                        </td>
                        <td class="text-center">{{ post.autor_nome }}</td>
                        <td class="text-center">{{ post.criado_em|date('d/m/Y H:i') }}</td>
                 


                            <td class="text-center">
                          <div class="btn-group btn-group-sm align-items-center" role="group" aria-label="Ações">
                            <a
                              href="/admin/posts/show/{{ post.id }}"
                              class="btn btn-info"
                              data-toggle="tooltip"
                              title="Visualizar detalhes do post"
                            >
                              <i class="fas fa-eye fa-fw"></i>
                            </a>
                            <a
                              href="/admin/posts/edit/{{ post.id }}"
                              class="btn btn-warning"
                              data-toggle="tooltip"
                              title="Editar"
                            >
                              <i class="fas fa-edit fa-fw"></i>
                            </a>
                            <button
                              type="submit"
                              form="del{{ post.id }}"
                              class="btn btn-danger"
                              data-toggle="tooltip"
                              title="Excluir"
                              aria-label="Excluir"
                            >
                              <i class="fas fa-trash-alt fa-fw"></i>
                            </button>
                            <div class="btn-group btn-group-sm" role="group">
                              <button
                                type="button"
                                class="btn btn-secondary dropdown-toggle"
                                data-toggle="dropdown"
                                aria-haspopup="true"
                                aria-expanded="false"
                                title="Mais ações"
                              >
                                <i class="fas fa-cog fa-fw"></i>
                              </button>
                              <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" href="#">
                                  <i class="fas fa-info-circle mr-2"></i> Detalhes
                                </a>
                                <a class="dropdown-item" href="#">
                                  <i class="fas fa-clone mr-2"></i> Duplicar
                                </a>
                              </div>
                            </div>
                          </div>

                          <form
                            id="del{{ post.id }}"
                            method="post"
                            action="/admin/posts/delete/{{ post.id }}"
                            style="display:none"
                            onsubmit="return confirm('Excluir post?');"
                          ></form>
                        </td>



                      </tr>
                    {% else %}
                      <tr>
                        <td colspan="7" class="text-center text-muted">
                          Nenhum post cadastrado.
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>

            <div class="card-footer py-3">
              <div class="row align-items-center">
                <div class="col-md-6">
                  <span class="text-muted">
                    Total de posts: <strong>{{ posts|length }}</strong> post(s)
                  </span>
                </div>
                <div class="col-md-6 text-right">
                  <a href="/admin/posts/create" class="btn btn-success font-weight-bold shadow-sm">
                    <i class="fas fa-plus"></i> Novo post
                  </a>
                </div>
              </div>
            </div>

          </div> {# /card #}
        </div>
      </div>
    </div>
  </section>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script>
    $(document).ready(function () {
      const table = $('#postsTable').DataTable({
        responsive: true,
        pagingType: 'simple_numbers',
        dom:
          "<'row align-items-center mb-3'<'col-md-4 dt-buttons'B><'col-md-4 text-center'l><'col-md-4'f>>" +
          "<'row'<'col-12'tr>>" +
          "<'row mt-2'<'col-md-5'i><'col-md-7'p>>",
        lengthMenu: [
          [5, 10, 15, 20, 25, -1],
          [5, 10, 15, 20, 25, 'Todos']
        ],
        pageLength: 5,
        buttons: [
          { extend: 'copy', text: '<i class="fas fa-copy"></i> Copiar', className: 'btn btn-sm btn-secondary' },
          { extend: 'csv', text: '<i class="fas fa-file-csv"></i> CSV', className: 'btn btn-sm btn-info' },
          { extend: 'excel', text: '<i class="fas fa-file-excel"></i> Excel', className: 'btn btn-sm btn-success' },
          {
            extend: 'pdfHtml5',
            text: '<i class="fas fa-file-pdf"></i> PDF',
            className: 'btn btn-sm btn-danger',
            orientation: 'landscape',
            pageSize: 'A4',
            title: 'Relatório de Posts'
          },
          {
            extend: 'print',
            text: '<i class="fas fa-print"></i> Imprimir',
            className: 'btn btn-sm btn-warning',
            title: 'Relatório de Posts'
          },
          { extend: 'colvis', text: '<i class="fas fa-eye"></i> Colunas', className: 'btn btn-sm btn-primary' }
        ],
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json'
        },
        columnDefs: [
          { orderable: false, targets: -1 },
          { className: 'text-center', targets: [0, 2, 3, 4, 5, 6] }
        ]
      });

      $('[data-toggle="tooltip"]').tooltip();
    });
  </script>
{% endblock %}
