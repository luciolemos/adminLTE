{% extends "layout_admin.twig" %}
{% block title %}Posts{% endblock %}

{% block content %}
<div class="container-fluid px-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Gerenciar Posts</h2>
    <a href="/admin/posts/create" class="btn btn-primary">
      <i class="fas fa-plus"></i> Novo Post
    </a>
  </div>

  {% if success %}
    <div class="alert alert-success">{{ success }}</div>
  {% endif %}
  {% if error %}
    <div class="alert alert-danger">{{ error }}</div>
  {% endif %}

  <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle" id="datatable-posts">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Título</th>
          <th>Categoria</th>
          <th>Status</th>
          <th>Autor</th>
          <th>Criado em</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        {% for post in posts %}
          <tr>
            <td>{{ post.id }}</td>
            <td>
              <a href="/blog/{{ post.slug }}" target="_blank">{{ post.titulo }}</a>
            </td>
            <td>{{ post.categoria }}</td>
            <td>
              {% if post.status == 'publicado' %}
                <span class="badge bg-success">Publicado</span>
              {% else %}
                <span class="badge bg-secondary">Rascunho</span>
              {% endif %}
            </td>
            <td>{{ post.autor_nome }}</td>
            <td>{{ post.criado_em|date('d/m/Y H:i') }}</td>
            <td>
              <a href="/admin/posts/edit/{{ post.id }}" class="btn btn-sm btn-warning">
                <i class="fas fa-edit"></i>
              </a>
              <form action="/admin/posts/delete/{{ post.id }}" method="POST" style="display:inline;" onsubmit="return confirm('Confirma exclusão?');">
                <button type="submit" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center text-muted">Nenhum post cadastrado.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
