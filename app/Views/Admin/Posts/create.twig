{% extends "layout_admin.twig" %}
{% block title %}Novo Post{% endblock %}
{% block content %}
<h2>Novo Post</h2>
<form method="post" enctype="multipart/form-data">
  <div class="mb-3">
    <label>Título</label>
    <input type="text" name="titulo" class="form-control" required value="{{ data.titulo|default('') }}">
  </div>
  <div class="mb-3">
    <label>Categoria</label>
    <select name="categoria" class="form-control">
      {% for cat in ['Apache','PHP','Java','Python','Javascript','MySQL','Twig','Bootstrap'] %}
        <option value="{{ cat }}" {% if data.categoria==cat %}selected{% endif %}>{{ cat }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="mb-3">
    <label>Conteúdo</label>
    <textarea name="conteudo" class="form-control" rows="8">{{ data.conteudo|default('') }}</textarea>
  </div>
  <div class="mb-3">
    <label>Imagem (opcional)</label>
    <input type="file" name="imagem" class="form-control">
  </div>
  <div class="mb-3">
    <label>Status</label>
    <select name="status" class="form-control">
      <option value="publicado" {% if data.status=='publicado' %}selected{% endif %}>Publicado</option>
      <option value="rascunho" {% if data.status=='rascunho' %}selected{% endif %}>Rascunho</option>
    </select>
  </div>
  <button type="submit" class="btn btn-success">Salvar</button>
  <a href="/admin/posts" class="btn btn-secondary">Cancelar</a>
  {% if errors.geral %}
    <div class="alert alert-danger mt-2">{{ errors.geral }}</div>
  {% endif %}
</form>
{% endblock %}
