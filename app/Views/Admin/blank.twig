{% extends 'admin_base.twig' %}

{% block title %}Tabela Avançada{% endblock %}

{% block content %}

  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1>Tabela Avançada</h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">Tabela Avançada</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-12">
          <div class="card card-primary card-outline">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-table mr-2"></i>
                Usuários do Sistema
              </h3>
              <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="maximize">
                  <i class="fas fa-expand"></i>
                </button>
                <div class="btn-group">
                  <button type="button" class="btn btn-tool dropdown-toggle" data-toggle="dropdown">
                    <i class="fas fa-wrench"></i>
                  </button>
                  <div class="dropdown-menu dropdown-menu-right" role="menu">
                    <a href="#" class="dropdown-item">Adicionar Usuário</a>
                    <a href="#" class="dropdown-item">Configurações</a>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item">Exportar Tudo</a>
                  </div>
                </div>
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                  <i class="fas fa-minus"></i>
                </button>
              </div>
            </div>
            
            <div class="card-body">
              <table id="advancedTable" class="table table-bordered table-striped table-hover" style="width:100%">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Usuário</th>
                    <th>Email</th>
                    <th>Cargo</th>
                    <th>Status</th>
                    <th>Cadastro</th>
                    <th>Último Login</th>
                    <th>Ações</th>
                  </tr>
                </thead>
                <tbody>
                  {% for i in 1..50 %}
                    <tr>
                      <td>{{ i }}</td>
                      <td>
                        <img src="https://i.pravatar.cc/150?img={{ i }}" class="user-avatar" alt="Avatar">
                        Usuário {{ i }}
                      </td>
                      <td>usuario{{ i }}@exemplo.com</td>
                      <td>
                        {% set roles = ['Admin', 'Editor', 'Moderador', 'Usuário'] %}
                        <span class="badge badge-{{ 
                          roles[i % 4] == 'Admin' ? 'danger' : 
                          (roles[i % 4] == 'Editor' ? 'warning' : 
                          (roles[i % 4] == 'Moderador' ? 'info' : 'secondary')) 
                        }}">
                          {{ roles[i % 4] }}
                        </span>
                      </td>
                      <td>
                        {% set statuses = ['Ativo', 'Inativo', 'Pendente', 'Banido'] %}
                        <span class="badge-status badge-{{ 
                          statuses[i % 4] == 'Ativo' ? 'success' : 
                          (statuses[i % 4] == 'Inativo' ? 'secondary' : 
                          (statuses[i % 4] == 'Pendente' ? 'warning' : 'danger')) 
                        }}">
                          {{ statuses[i % 4] }}
                        </span>
                      </td>
                      <td>{{ "now"|date_modify("-#{i} days")|date('d/m/Y') }}</td>
                      <td>{{ "now"|date_modify("-#{i % 24} hours")|date('d/m/Y H:i') }}</td>
                      <td>
                        <div class="btn-group btn-group-xs">
                          <button class="btn btn-info" title="Visualizar">
                            <i class="fas fa-eye"></i>
                          </button>
                          <button class="btn btn-warning" title="Editar">
                            <i class="fas fa-edit"></i>
                          </button>
                          <button class="btn btn-danger" title="Excluir">
                            <i class="fas fa-trash"></i>
                          </button>
                          <div class="btn-group btn-group-xs">
                            <button type="button" class="btn btn-secondary dropdown-toggle dropdown-icon" data-toggle="dropdown">
                              <i class="fas fa-cog"></i>
                            </button>
                            <div class="dropdown-menu">
                              <a class="dropdown-item" href="#"><i class="fas fa-key mr-2"></i> Redefinir Senha</a>
                              <a class="dropdown-item" href="#"><i class="fas fa-ban mr-2"></i> Suspender</a>
                              <a class="dropdown-item" href="#"><i class="fas fa-envelope mr-2"></i> Enviar Mensagem</a>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
                <tfoot>
                  <tr>
                    <th>ID</th>
                    <th>Usuário</th>
                    <th>Email</th>
                    <th>Cargo</th>
                    <th>Status</th>
                    <th>Cadastro</th>
                    <th>Último Login</th>
                    <th>Ações</th>
                  </tr>
                </tfoot>
              </table>
            </div>
            
            <div class="card-footer">
              <div class="row">
                <div class="col-md-6">
                  <div class="btn-group">
                    <button type="button" class="btn btn-success">
                      <i class="fas fa-plus"></i> Novo Usuário
                    </button>
                    <button type="button" class="btn btn-default">
                      <i class="fas fa-sync-alt"></i> Atualizar
                    </button>
                  </div>
                </div>
                <div class="col-md-6 text-right">
                  <small class="text-muted">
                    Mostrando <span id="showing">1-10</span> de <span id="total">50</span> registros
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

{% endblock %}

{% block scripts %}
{{ parent() }}
<!-- DataTables & Plugins -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap4.min.js"></script>
<script src="https://cdn.datatables.net/rowgroup/1.4.0/js/dataTables.rowGroup.min.js"></script>
<script src="https://cdn.datatables.net/select/1.7.0/js/dataTables.select.min.js"></script>
<script src="/assets/js/main.js"></script>
{% endblock %}