{# Users/_footer_actions.twig #}
<div class="card-footer d-flex flex-column flex-md-row" style="gap:.75rem;">
  
  <a href="/admin/users" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Voltar à lista
  </a>

  {% if show_save %}
    <button type="submit" class="btn btn-primary">
      <i class="fas fa-save"></i> Salvar
    </button>
  {% endif %}

  {% if show_edit %}
    <a href="/admin/users/edit/{{ usuario.id }}?return_to=show" class="btn btn-warning"><i class="fas fa-edit"></i> Editar
    </a>
  {% endif %}

  {% if show_cancel %}
    <a href="/admin/users" class="btn btn-alert alert-warning"><i class="fas fa-times"></i> Cancelar</a>
  {% endif %}

  {# Botão de deletar só aparece para quem tem permissão! #}
  {% if show_delete and user_has_permission('user_delete') %}
    <form method="post" action="{{ delete_url }}" onsubmit="return confirm('Excluir este usuário?');" style="display:inline;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="btn btn-danger">
        <i class="fas fa-trash-alt"></i> Excluir
      </button>
    </form>
  {% endif %}
</div>
