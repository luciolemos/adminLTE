{% extends 'layout_admin.twig' %}
{% block title %}Usuários por Status{% endblock %}
{% block content %}
<div class="container-fluid pt-4">
  <h1>{{ title }}</h1>
  <p>Visualize abaixo a distribuição dos usuários por status.</p>
</div>

<div class="card shadow mb-4">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0"><i class="fas fa-chart-bar mr-2"></i> Usuários por Status</h3>
  </div>
  <div class="card-body">
    <canvas id="pieChart" style="height:400px;width:100%;"></canvas>
  </div>
</div>

<script src="/assets/adminlte/plugins/chart.js/Chart.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const ctx = document.getElementById('pieChart').getContext('2d');
  new Chart(ctx, {
    type: 'pie',
    data: {
      labels: {{ statusLabels|json_encode|raw }},
      datasets: [{
        data: {{ statusCounts|json_encode|raw }},
        backgroundColor: [
          '#28a745', '#6c757d', '#ffc107', '#dc3545'
        ],
        borderWidth: 2
      }]
    },
    options: {
      plugins: {
        legend: { position: 'right' }
      }
    }
  });
});
</script>
{% endblock %}
