{% extends 'layout_admin.twig' %}

{% block title %}{{ title|default('Gráfico de Cargos') }}{% endblock %}

{% block content %}
<div class="container-fluid pt-4">
  <h1>{{ title }}</h1>
    <p>Distribuição dos usuários por cargo</p>
</div>

<div class="card shadow mb-4">
  <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0"><i class="fas fa-chart-bar mr-2"></i> Distribuição dos usuários por cargo</h3>
  </div>
  <div class="card-body">
    <canvas id="pieChart" style="height:400px;width:100%;"></canvas>
  </div>
</div>

<script src="/assets/adminlte/plugins/chart.js/Chart.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const ctx = document.getElementById('pieChart').getContext('2d');
  new Chart(ctx, {
    type: 'pie',
    data: {
      labels: {{ cargoLabels|json_encode|raw }},
      datasets: [{
        data: {{ cargoCounts|json_encode|raw }},
        backgroundColor: [
          '#007bff', '#17a2b8', '#ffc107', '#343a40'
        ],
        borderWidth: 2
      }]
    },
    options: {
      plugins: {
        legend: { position: 'bottom' }
      }
    }
  });
});
</script>
{% endblock %}
