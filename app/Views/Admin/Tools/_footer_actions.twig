{# Tools/_footer_actions.twig #}
<div class="card-footer d-flex flex-column flex-md-row" style="gap: .75rem;">

  {# Imprimir (opcional) #}
  {% if show_print %}
    <button type="button"
            id="btnPrint"
            class="btn btn-info"
            data-toggle="tooltip"
            title="Imprimir esta página">
      <i class="fas fa-print mr-1"></i> Imprimir
    </button>
  {% endif %}

  {# PDF (opcional) #}
  {% if show_pdf %}
    <button type="button"
            id="btnPdf"
            class="btn btn-outline-danger"
            data-toggle="tooltip"
            title="Gerar PDF desta página">
      <i class="fas fa-file-pdf mr-1"></i> PDF
    </button>
  {% endif %}

  {# Voltar à lista #}
  <a href="/admin/tools"
     class="btn btn-secondary"
     data-toggle="tooltip"
     title="Voltar à lista de ferramentas">
    <i class="fas fa-arrow-left mr-1"></i> Voltar à lista
  </a>

  {# Salvar (opcional) #}
  {% if show_save %}
    <button type="submit"
            class="btn btn-primary"
            data-toggle="tooltip"
            title="Salvar alterações">
      <i class="fas fa-save mr-1"></i> Salvar
    </button>
  {% endif %}

  {# Cancelar (opcional) #}
  {% if show_cancel %}
    <a href="/admin/tools"
       class="btn btn-warning"
       data-toggle="tooltip"
       title="Cancelar e voltar à lista">
      <i class="fas fa-ban mr-1"></i> Cancelar
    </a>
  {% endif %}

  {# Excluir (opcional) #}
  {% if show_delete %}
    <form method="post"
          action="{{ delete_url }}"
          onsubmit="return confirm('Excluir esta ferramenta?');"
          style="display:inline;">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit"
              class="btn btn-danger"
              data-toggle="tooltip"
              title="Excluir esta ferramenta">
        <i class="fas fa-trash-alt mr-1"></i> Excluir
      </button>
    </form>
  {% endif %}

</div>
