{% extends "layout_admin.twig" %}
{% block title %}Detalhes da Ferramenta{% endblock %}

{% block styles %}
  {{ parent() }}
  {% include 'Admin/Partials/_show_common_styles.twig' %}
{% endblock %}

{% block content %}
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1><i class="fas fa-tools"></i> {{ title }}</h1>
        </div>
        <div class="col-sm-6">
          {% include 'Partials/_breadcrumb.twig' %}
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      <div class="card show-card shadow" id="toolShowCard">
        <div class="card-header">
          <div class="card-tools">
            <a href="/admin/dashboard" class="btn btn-tool" title="Dashboard">
              <i class="fas fa-tachometer-alt"></i>
            </a>
            <button type="button" class="btn btn-tool" data-card-widget="maximize" title="Maximizar">
              <i class="fas fa-expand"></i>
            </button>
            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
              <i class="fas fa-minus"></i>
            </button>
          </div>
        </div>

        <div class="card-body">
          <div class="row">
            <div class="col-md-3 text-center mb-3">
              <img src="{{ tool.img_tool|default('/assets/adminlte/dist/img/default_tool.jpg') }}"
                   class="rounded shadow-sm border" style="width:300px; height:200px; object-fit:cover;">
              <h5 class="mt-2">{{ tool.desc_tool }}</h5>
              <span class="badge badge-pill badge-info">{{ tool.type_tool }}</span>
            </div>
            <div class="col-md-9">
              <table class="table table-bordered table-striped mb-0">
                <tr><th>ID</th><td>{{ tool.id }}</td></tr>
                <tr><th>Descrição</th><td>{{ tool.desc_tool }}</td></tr>
                <tr><th>Características</th><td>{{ tool.caracteristica_tool|default('-')|nl2br }}</td></tr>
                <tr><th>Categoria</th><td>{{ tool.cat_tool }}</td></tr>
                <tr><th>Estado</th><td>{{ tool.type_tool }}</td></tr>
                <tr><th>Data de Aquisição</th><td>{{ tool.data_aquisicao|date('d/m/Y') }}</td></tr>
              </table>
            </div>
          </div>
        </div>

        {% include 'Admin/Partials/_footer_actions.twig' with {
          module: 'tools',
          entity: tool,
          csrf_token: csrf_token,
          show_print: true,
          show_pdf: true,
          show_edit: true,
          show_delete: true,
          show_cancel: true
        } %}
      </div>
    </div>
  </section>
{% endblock %}
