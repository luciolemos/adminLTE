{% extends "layout_site.twig" %}
{% block title %}{{ post.titulo }}{% endblock %}
{% block styles %}
  <style>
    .blog-post {
      background: #fff;
      border-radius: 1.25rem;
      box-shadow: 0 4px 32px #0001;
      padding: 2.4rem 2.2rem;
      margin: 2rem auto 3rem auto;
      max-width: 820px;
      border: 1px solid #ececec;
      position: relative;
    }
    .blog-post .post-meta {
      font-size: 0.96rem;
      color: #6c757d;
      margin-bottom: 1.2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: 0.04em;
    }
    .blog-post .post-meta .badge-category {
      background: linear-gradient(90deg, #2563eb 0%, #38b6ff 100%);
      color: #fff;
      border-radius: 1rem;
      padding: 0.26rem 0.85rem;
      font-size: 0.89em;
      font-weight: 600;
      letter-spacing: .03em;
    }
    .blog-post .post-title {
      font-size: 2.25rem;
      font-weight: 800;
      color: #2563eb;
      margin-bottom: .5rem;
      margin-top: .7rem;
      letter-spacing: -0.01em;
    }
    .blog-post .post-subtitle {
      font-size: 1.2rem;
      color: #555;
      margin-bottom: 0.8rem;
      font-weight: 400;
    }
    .blog-post .post-image {
      max-height: 320px;
      object-fit: cover;
      border-radius: 1.1rem;
      box-shadow: 0 2px 18px #2651a929;
      margin-bottom: 2rem;
      width: 100%;
      margin-top: 1rem;
    }
    .blog-post .post-content {
      font-size: 1.15rem;
      line-height: 1.9;
      color: #292929;
      margin-top: 1.3rem;
    }
    .blog-post .post-content h2, .blog-post .post-content h3 {
      margin-top: 2.2rem;
      margin-bottom: 1rem;
      font-weight: 700;
      color: #2563eb;
    }
    .blog-post .post-content img {
      max-width: 100%;
      border-radius: 0.6rem;
      margin: 1.2rem 0;
      box-shadow: 0 2px 12px #0011;
    }
    .blog-post blockquote {
      border-left: 4px solid #2563eb;
      background: #f3f6fd;
      color: #345;
      font-style: italic;
      margin: 1.6rem 0;
      padding: .9rem 1.4rem;
      border-radius: .45rem;
      font-size: 1.13em;
    }
    .post-cta .btn {
      margin: 0 .45rem .6rem .45rem;
      border-radius: 1.5rem;
      font-weight: 600;
      box-shadow: 0 2px 10px #2563eb14;
      transition: transform .12s;
    }
    .post-cta .btn:hover {
      transform: translateY(-2px) scale(1.03);
    }

    @media (max-width: 768px) {
      .blog-post { padding: 1.1rem 0.7rem; }
      .blog-post .post-title { font-size: 1.4rem; }
    }

    .cta-whatsapp-animate {
      background: linear-gradient(90deg, #34d058, #25d366 60%, #128c7e 100%);
      color: #fff;
      border-radius: 1.5rem;
      box-shadow: 0 6px 24px #128c7e33;
      padding: 2.2rem 1.6rem 2rem 1.6rem;
      margin-top: 3.5rem;
      margin-bottom: 0;
      text-align: center;
      position: relative;
      overflow: hidden;
      animation: ctaPop 1.3s cubic-bezier(.66, .2, .35, 1.08);
      transition: box-shadow .2s, transform .22s;
    }
    .cta-whatsapp-animate:hover {
      box-shadow: 0 10px 34px #128c7e44;
      transform: translateY(-4px) scale(1.035);
    }
    @keyframes ctaPop {
      0% { transform: scale(.92) translateY(30px); opacity: 0; }
      70% { transform: scale(1.04) translateY(-10px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    .cta-whatsapp-animate .whatsapp-btn {
      background: #25d366;
      color: #fff;
      border: none;
      padding: 1rem 2.2rem;
      border-radius: 40px;
      font-size: 1.2rem;
      font-weight: 700;
      box-shadow: 0 2px 10px #25d36655;
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      margin-top: 1.3rem;
      transition: background .16s, box-shadow .18s, transform .14s;
      animation: bounceBtn 1.1s 1.4s both;
      text-decoration: none;
    }
    .cta-whatsapp-animate .whatsapp-btn:hover {
      background: #128c7e;
      color: #fff;
      box-shadow: 0 4px 16px #128c7e55;
      transform: scale(1.045);
    }
    @keyframes bounceBtn {
      0% { transform: scale(0.95);}
      60% { transform: scale(1.10);}
      100% { transform: scale(1);}
    }
    .cta-whatsapp-animate .fa-whatsapp {
      font-size: 2.1rem;
      vertical-align: middle;
      color: #fff;
      filter: drop-shadow(0 2px 6px #25d366bb);
      transition: color .18s;
    }
    .cta-whatsapp-animate .cta-sub {
      font-size: 1.1rem;
      opacity: 0.88;
      margin-top: 0.5rem;
      color: #eaffea;
    }
    @media (max-width: 767px) {
      .cta-whatsapp-animate { padding: 1.5rem 0.5rem; }
      .cta-whatsapp-animate .whatsapp-btn { width: 100%; justify-content: center;}
    }

    .whatsapp-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      margin-right: .5rem;
      object-fit: cover;
    }
    .custom-cta-hero {
      background: linear-gradient(90deg, #25d366 0%, #128C7E 100%);
      border-radius: 1.4rem;
      color: #fff;
      position: relative;
      overflow: hidden;
      box-shadow: 0 6px 24px #128C7E22;
      animation: fadeInUp 1.3s cubic-bezier(.25,.46,.45,.94) both;
    }

    .cta-avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      border: 3px solid #fff;
      box-shadow: 0 4px 20px #0002;
      object-fit: cover;
      background: #eee;
      transition: transform .25s;
    }
    .cta-avatar:hover { transform: scale(1.07) rotate(-2deg); }

    .cta-title-hero {
      font-size: 2rem;
      text-shadow: 0 2px 10px #128C7E33;
    }
    .cta-subtitle {
      font-size: 1.1rem;
      margin-bottom: 1.1rem;
    }

    .whatsapp-btn-hero {
      background: #25d366;
      color: #fff;
      font-weight: bold;
      padding: .7rem 1.8rem;
      border-radius: 99px;
      font-size: 1.12rem;
      box-shadow: 0 2px 10px #128C7E2a;
      transition: background .2s, box-shadow .2s, transform .13s;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: .8rem;
      animation: pulseWhatsapp 1.5s infinite;
    }
    .whatsapp-btn-hero:hover {
      background: #128C7E;
      color: #fff;
      transform: scale(1.03);
      box-shadow: 0 6px 18px #128C7E44;
    }

    @keyframes pulseWhatsapp {
      0%, 100% { box-shadow: 0 2px 8px #25d36644, 0 0 0 0 #25d36644; }
      70% { box-shadow: 0 2px 18px #128C7E33, 0 0 0 10px #25d36611; }
    }
    @keyframes fadeInUp {
      0% { opacity: 0; transform: translateY(60px);}
      100% { opacity: 1; transform: translateY(0);}
    }
  </style>
{% endblock %}

{% block content %}
  <article class="blog-post">
    <div class="post-meta">
      <span class="badge-category">{{ post.categoria }}</span>
      <span>&middot;</span>
      <span><i>by</i> <strong>{{ post.autor_nome }}</strong></span>
      <span>&middot;</span>
      <span>{{ post.criado_em|date("d/m/Y H:i") }}</span>
    </div>

    <h1 class="post-title">{{ post.titulo }}</h1>

    {% if post.imagem %}
      <img src="{{ post.imagem }}" class="post-image" alt="Imagem de capa">
    {% endif %}

    <div class="post-content">
      {{ post.conteudo|raw }}
    </div>
    
    <div class="author-meta mt-auto">
            {% if post.autor_avatar %}
              <img src="{{ post.autor_avatar }}" alt="Seu Nome" class="cta-avatar mb-3 mb-md-0 me-md-4 shadow-sm" loading="lazy" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" loading="lazy">
            {% endif %}
            <span> 
              {{ post.autor_nome }}<br>
              <small class="text-muted">{{ post.criado_em|date('d/m/Y H:i') }}</small>
            </span>
     </div>

    {#<div class="cta-whatsapp-animate">
      <div style="display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 1rem;">
        <img 
          src="{{ post.autor_avatar }}" 
          alt="Seu Nome" 
          class="cta-avatar" 
          loading="lazy"
          style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;"
        >
        <div>
          <div class="cta-subtitle">Tire dúvidas, peça orçamento ou converse agora mesmo:</div>
          <a 
            class="whatsapp-btn"
            href="https://wa.me/{{ whatsapp_numero|default('5584996360721') }}?text={{ whatsapp_texto|url_encode|default('Olá! Vim pelo Portal Fullstack PHP e quero saber mais.') }}"
            target="_blank" 
            rel="noopener"
          >
            <i class="fab fa-whatsapp"></i>
            <span>Falar com {{ post.autor_nome }}</span>
          </a>
        </div>
      </div>
    </div>#}

    <div class="post-cta" style="text-align: center; margin-top: 2rem;">
      <span style="display: block; margin-bottom: 0.5rem;">Compartilhe este post:</span>
      <a 
        href="https://twitter.com/share?url={{ post.url }}" 
        target="_blank" 
        class="btn" 
        style="border-radius: 1.5rem; padding: 0.5rem 1rem; margin: 0 0.5rem 0.5rem 0;"
      >
        <i class="fab fa-twitter"></i> Twitter
      </a>
      <a 
        href="https://www.linkedin.com/shareArticle?mini=true&url={{ post.url }}" 
        target="_blank" 
        class="btn" 
        style="border-radius: 1.5rem; padding: 0.5rem 1rem; margin: 0 0.5rem 0.5rem 0;"
      >
        <i class="fab fa-linkedin"></i> LinkedIn
      </a>
      <a 
        href="https://www.facebook.com/sharer/sharer.php?u={{ post.url }}" 
        target="_blank" 
        class="btn" 
        style="border-radius: 1.5rem; padding: 0.5rem 1rem; margin: 0 0 0.5rem 0;"
      >
        <i class="fab fa-facebook"></i> Facebook
      </a>
    </div>
  </article>
{% endblock %}