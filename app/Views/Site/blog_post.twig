{% extends "layout_site.twig" %}
{% block title %}{{ post.titulo }}{% endblock %}

{% block styles %}
<style>
  article.blog-post {
    background: #fff;
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: 0 8px 36px #0001;
  }

  article.blog-post img {
    max-width: 100%;
    border-radius: 1rem;
    margin: 1.5rem 0;
    box-shadow: 0 4px 16px #0002;
  }

  article.blog-post h1 {
    color: #2a3b8f;
    font-weight: 700;
  }

  article.blog-post p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #444;
  }

  .post-meta {
    color: #777;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .post-meta img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: .6rem;
  }

  .post-meta span {
    vertical-align: middle;
  }
</style>
{% endblock %}

{% block content %}
<section class="content-header mb-4">
  <div class="container-fluid">
    {% include 'Partials/_breadcrumb.twig' %}
  </div>
</section>

<div class="container">
  <article class="blog-post mb-5">
    <header>
      <h1 class="mb-3">{{ post.titulo }}</h1>
      {#<div class="post-meta d-flex align-items-center">
        {% if post.autor_avatar %}
          <img src="{{ post.autor_avatar }}" alt="{{ post.autor_nome }}">
        {% endif %}
        <span>{{ post.autor_nome }} • {{ post.criado_em|date('d/m/Y H:i') }} • <strong>{{ post.categoria }}</strong></span>
      </div>#}

      <div class="post-meta d-flex align-items-center">
  {% if post.autor_avatar %}
    <img src="{{ post.autor_avatar }}" class="author-avatar" alt="{{ post.autor_nome }}">
  {% endif %}
  <div class="author-info">
    <strong>{{ post.autor_nome }}</strong>
    <small>• {{ post.criado_em|date('d/m/Y H:i') }} • <strong>{{ post.categoria }}</strong></small>
  </div>
</div>

    </header>

    {% if post.imagem %}
      <img src="{{ post.imagem }}" alt="Imagem de capa do post">
    {% endif %}

    <section class="mt-4">
      {{ post.conteudo|raw }}
    </section>
  </article>

  <div class="text-end">
    <a href="/blog" class="btn btn-outline-primary"><i class="fas fa-arrow-left"></i> Voltar ao blog</a>
  </div>
</div>
{% endblock %}
