{% extends "layout_site.twig" %}
{% block title %}Sobre o Projeto — Arquitetura & Recursos{% endblock %}

{% block styles %}
  <style>
    :root {
      --gradient-primary: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
      --gradient-success: linear-gradient(135deg, #198754 0%, #0d6e3d 100%);
    }
    
    .about-section {
      background: #fff;
      border-radius: 1.2rem;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
      padding: 2.5rem;
      margin-bottom: 2.5rem;
      border: 1px solid rgba(0, 0, 0, 0.03);
    }
    
    .about-section h2 {
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
    }
    
    .about-list li {
      margin-bottom: 0.8rem;
      position: relative;
      padding-left: 1.5rem;
    }
    
    .about-list li:before {
      
      color: #2563eb;
      position: absolute;
      left: 0;
      font-weight: bold;
    }
    
    .about-list strong {
      background: var(--gradient-success);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-weight: 600;
    }
    
    .about-section h4 {
      margin-top: 2.5rem;
      color: #2563eb;
      font-weight: 700;
      border-bottom: 2px solid #f0f4ff;
      padding-bottom: 0.5rem;
    }
    
    .code-block {
      background: #f8f9fa;
      border-radius: 0.5rem;
      padding: 1.2rem 1.4rem;
      font-size: 0.95rem;
      margin-bottom: 1.2rem;
      border-left: 4px solid #2563eb;
      font-family: 'Fira Code', monospace;
    }
    
    .feature-badge {
      font-size: 0.85rem;
      margin: 0.2rem;
      padding: 0.35rem 0.7rem;
      border-radius: 50px;
      font-weight: 500;
    }
    
    .about-timeline li {
      font-size: 1.05rem;
      margin-bottom: 0.5rem;
      position: relative;
      padding-left: 1.8rem;
    }
    
    .about-timeline li:before {
     
      color: #198754;
      position: absolute;
      left: 0;
      font-weight: bold;
    }
    
    .team-card {
      transition: all 0.3s ease;
      border: none;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }
    
    .team-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }
    
    .team-card .card-img-top {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border: 3px solid #fff;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
    
    .tech-icon {
      font-size: 1.8rem;
      margin-right: 0.8rem;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    
    .timeline-item {
      position: relative;
      padding-left: 2.5rem;
      margin-bottom: 1.5rem;
    }
    
    .timeline-item:before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #2563eb;
    }
    
    .timeline-item:after {
      content: "";
      position: absolute;
      left: 9px;
      top: 20px;
      width: 2px;
      height: 100%;
      background: #e9ecef;
    }
    
    .timeline-item:last-child:after {
      display: none;
    }
    
    .tech-stack-icon {
      width: 50px;
      height: 50px;
      margin: 0 auto;
      display: block;
      filter: grayscale(30%);
      transition: all 0.3s ease;
    }
    
    .tech-stack-icon:hover {
      filter: grayscale(0%);
      transform: scale(1.1);
    }
  </style>
{% endblock %}


