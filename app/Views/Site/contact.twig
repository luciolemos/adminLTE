{% extends "layout_site.twig" %}
{% block title %}Contato{% endblock %}

{% block content %}

<section class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1><i class="fas fa-envelope"></i> {{ title }}</h1>
      </div>
      <div class="col-sm-6">
        {% include 'Partials/_breadcrumb.twig' %}
      </div>
    </div>
  </div>
</section>


<div class="d-flex align-items-center justify-content-center">
  <div class="container-fluid">
    <div class="card shadow-sm border-0" style="max-width: 460px; margin:auto;">
   
     {# --- CARD-HEADER AZUL/PRIMARY --- #}
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <h3 class="card-title mb-0">
          <i class="fas fa-envelope me-2"></i> Formulário de contato
        </h3>
      </div>
      <div class="card-body">
        <p class="mb-4 text-muted text-center small">
          Tem dúvidas, sugestões ou encontrou algum problema?<br>
          Envie sua mensagem abaixo, responderemos o mais rápido possível!
        </p>
        <form method="post" action="/contact" autocomplete="off">
          <div class="form-group mb-3">
            <label for="nome" class="font-weight-bold">Nome</label>
            <input type="text" class="form-control" id="nome" name="nome" required placeholder="Seu nome completo">
          </div>
          <div class="form-group mb-3">
            <label for="email" class="font-weight-bold">E-mail</label>
            <input type="email" class="form-control" id="email" name="email" required placeholder="Seu e-mail">
          </div>
          <div class="form-group mb-4">
            <label for="mensagem" class="font-weight-bold">Mensagem</label>
            <textarea class="form-control" id="mensagem" name="mensagem" rows="4" required placeholder="Digite sua mensagem..."></textarea>
          </div>
          <div class="d-flex flex-wrap justify-content-between align-items-center">
            <a href="/" class="text-secondary small">
              <i class="fas fa-arrow-left me-1"></i>Voltar ao site
            </a>
            <button type="submit" class="btn btn-primary px-4 text-white">
              <i class="fas fa-paper-plane me-2"></i>Enviar
            </button>
          </div>
        </form>
        <hr>
        <div class="mt-3 text-muted small text-center">
          <i class="fas fa-shield-alt me-1"></i>
          Seus dados são tratados com segurança e não serão compartilhados.
        </div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
