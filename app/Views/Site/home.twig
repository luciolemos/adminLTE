{% extends "layout_site.twig" %}
{% import "Partials/macros.twig" as macros %}
{% block title %}Bem-vindo ao Portal{% endblock %}

{% block styles %}
  <style>
    .bg-gradient {
      background: linear-gradient(90deg, #2468f2 0%, #4876e8 51%, #13c3c3 100%);
      {# background: linear-gradient(90deg,rgb(3, 11, 27) 0%,rgb(20, 21, 24) 51%,rgb(11, 12, 12) 100%);#}
      background-size: 200% 200%;
      animation: gradientBG 5s ease-in-out infinite;
    }
    @keyframes gradientBG {
      0% {background-position:0% 50%;}
      50% {background-position:100% 50%;}
      100% {background-position:0% 50%;}
    }
    .hero-animated {
      box-shadow: 0 8px 36px #2651a91a;
      position: relative;
      overflow: hidden;
     
    }
    .avatar-profile {
      width: 120px;
      height: 120px;
      object-fit: cover;
      border: 4px solid #fff3;
      margin-bottom: 1rem;
      box-shadow: 0 2px 16px #0001;
    }
    .feature-icon {
      font-size: 2.2rem;
      margin-bottom: 1rem;
    }
    .card {
      transition: transform .18s;
    }
    .card:hover {
      transform: translateY(-8px) scale(1.03);
      box-shadow: 0 6px 30px #3657b26a;
    }
    .section-divider {
      height: 2px;
      width: 60px;
      background: #13c3c3;
      opacity: 0.5;
      margin: 2.7rem auto;
      border-radius: 99px;
    }
    .cta-area {
      gap: 1.2rem;
      margin-top: 2rem;
    }
    @media (max-width: 767px) {
      .hero-animated { padding: 1.2rem 0.7rem; }
      .bg-gradient { padding: 1.2rem 0.8rem; }
      .avatar-profile { width: 80px; height: 80px; }
    }
    
  </style>
{% endblock %}

  {# --------------------------------------------------------------------
     HERO PRINCIPAL: Banner, Avatar e Ação Rápida
  -------------------------------------------------------------------- #}
{% block hero %}

  <div class="bg-gradient text-white p-5 mb-5 shadow text-center hero-animated">
    <h1 class="display-5 fw-bold mb-2">
      <i class="fas fa-cube me-2"></i> Portal Fullstack PHP
    </h1>
    <div class="mb-2 h6 fw-normal opacity-75">
      Ubuntu • Apache • PHP • MySQL • MVC Design Pattern
    </div>
    
    {% if user %}
      <img src="{{ user.avatar|default('/assets/adminlte/dist/img/avatar7.png') }}" alt="Avatar"
        class="avatar-profile rounded-circle shadow-sm mx-auto d-block" loading="lazy">
      <div class="mb-2 mt-2">
        <h4 class="mb-1">{{ user.nome }}</h4>
        <span class="me-2">{{ macros.badge_cargo(user.cargo) }}</span>
        <span>{{ macros.badge_status(user.status) }}</span>
      </div>
      {% if user.cargo == 'Admin' %}
        <p class="lead mb-2">
          Bem-vindo ao painel administrativo. Gerencie usuários, permissões e todo o ecossistema da aplicação.
        </p>
        <a href="/admin/dashboard" class="btn btn-success shadow">
          <i class="fas fa-tachometer-alt"></i> Dashboard Admin
        </a>
      {% else %}
        <p class="lead mb-2">
          Sua conta está ativa e você já pode explorar todas as funcionalidades do sistema.
        </p>
        <a href="/profile" class="btn btn-success shadow">
          <i class="fas fa-user-cog"></i> Meu Perfil
        </a>
      {% endif %}
    {% else %}
      <p class="lead mb-3">
        Sistema modular, responsivo e escalável em PHP moderno. Perfeito para quem busca qualidade profissional do deploy ao painel!
      </p>
      <div class="d-flex flex-column flex-md-row justify-content-center cta-area">
        <a href="/register" class="btn btn-light shadow fw-bold">
          <i class="fas fa-user-plus me-1"></i> Quero me cadastrar
        </a>
        <a href="/login" class="btn btn-outline-light shadow">
          <i class="fas fa-unlock me-1"></i> Já tenho uma conta
        </a>
      </div>
    {% endif %}
  </div>
{% endblock %}

