{% extends "layout_admin.twig" %}
{% block title %}README{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="container-fluid">
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fas fa-book mr-2"></i> README & Manual do Projeto
                </h3>
            </div>
            <div class="card-body markdown-body" style="background: #fff;">
                {{ readme_html|raw }}
            </div>
        </div>
    </div>
</div>

<!-- Mermaid.js para renderizar diagrams -->
<script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (window.mermaid) mermaid.init();
    });
</script>
<style>
/* Markdown tipo GitHub + integração AdminLTE */
.markdown-body {
    color: #222;
    font-size: 1.05rem;
    line-height: 1.7;
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    background: #fff;
    border-radius: 0.75rem;
    padding: 2rem 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 2px 8px rgba(44,62,80,0.06);
}
.markdown-body h1, .markdown-body h2, .markdown-body h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #0056b3;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.4rem;
    font-weight: 600;
}
.markdown-body h1 { font-size: 2.2rem; }
.markdown-body h2 { font-size: 1.6rem; }
.markdown-body h3 { font-size: 1.25rem; }
.markdown-body pre, .markdown-body code {
    background: #23272c;
    color: #e0e0e0;
    border-radius: 0.4rem;
    font-size: 0.97rem;
    padding: 0.3em 0.7em;
}
.markdown-body pre {
    padding: 1.1em;
    margin: 1.5em 0;
    overflow-x: auto;
    background: #181e28;
    box-shadow: 0 1px 4px rgba(44,62,80,0.08);
}
.markdown-body code {
    background: #272c33;
}
.markdown-body blockquote {
    border-left: 5px solid #3c8dbc;
    background: #f8f9fa;
    color: #555;
    margin: 1.5em 0;
    padding: 1em 1.5em;
    border-radius: 0.5em;
    font-size: 1.03em;
}
.markdown-body ul, .markdown-body ol {
    margin-left: 2em;
}
.markdown-body table {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5em 0;
    background: #f5f5f5;
    font-size: 0.97em;
    border-radius: 0.5em;
    overflow-x: auto;
    display: block;
}
.markdown-body th, .markdown-body td {
    border: 1px solid #d1d5da;
    padding: 0.6em 1em;
    text-align: left;
}
.markdown-body th {
    background: #e9ecef;
}
.markdown-body img {
    max-width: 100%;
    border-radius: 0.4em;
    margin: 1em 0;
}
.markdown-body .mermaid {
    background: #fff !important;
    border-radius: 0.5em;
    margin: 2em 0;
    box-shadow: 0 1px 8px rgba(44, 62, 80, 0.08);
}
@media (max-width: 767px) {
    .markdown-body {
        padding: 1rem 0.4rem;
        font-size: 0.99rem;
    }
    .card-header .card-title { font-size: 1.15rem; }
}
</style>
{% endblock %}
