{% if flash %}
  <div class="alert alert-{{ flash.type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show mb-3" role="alert">
    {{ flash.msg }}
    <button type="button" class="close" data-dismiss="alert" aria-label="Fechar">
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
{% endif %}
